// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  user_id     Int   @id @default(autoincrement()) 
  name        String  
  email       String
  password    String
  created_at  DateTime @default(now())

  boards Board[]
}

model Board {
  board_id        Int       @id @default(autoincrement())
  user_id         Int
  board_name      String    @db.VarChar(50)
  description     String?   @db.VarChar(500)
  last_updated_at DateTime  @updatedAt
  processed_at    DateTime?

  user          User           @relation(fields: [user_id], references: [user_id])
  videos        Video[]
  narratives    Narrative[]
  boardChannels BoardChannel[]
  keywords      Keyword[]
}


model Channel {
  channel_id    String    @id @db.VarChar(50)
  channel_title String    @db.VarChar(500)
  processed_at  DateTime?

  videos        Video[]
  transcripts   Transcript[]
  boardChannels BoardChannel[]
}

model Video {
  video_id         String    @id @db.VarChar(20)
  board_id         Int
  channel_id       String    @db.VarChar(50)
  title            String    @db.VarChar(500)
  description      String?   @db.Text
  view_count       Int
  duration_seconds Int?
  published_at     DateTime
  processed        Boolean   @default(false)
  processed_at     DateTime?

  board      Board        @relation(fields: [board_id], references: [board_id])
  channel    Channel      @relation(fields: [channel_id], references: [channel_id])
  transcript Transcript?
  comments   Comment[]
  claims     Claim[]
}

model Transcript {
  transcript_id Int       @id @default(autoincrement())
  video_id      String    @unique @db.VarChar(20)
  channel_id    String?   @db.VarChar(50)
  video_title   String    @db.VarChar(500)
  transcript    String    @db.Text
  processed_at  DateTime?

  video   Video               @relation(fields: [video_id], references: [video_id])
  channel Channel?            @relation(fields: [channel_id], references: [channel_id])
  chunks  TranscriptChunk[]
}

model TranscriptChunk {
  chunk_id      Int       @id @default(autoincrement())
  transcript_id Int
  video_title   String    @db.VarChar(500)
  chunk_text    String    @db.Text
  chunk_number  Int
  processed_at  DateTime?

  transcript Transcript @relation(fields: [transcript_id], references: [transcript_id])
}

model Comment {
  comment_id           String    @id @db.VarChar(50)
  video_id             String    @db.VarChar(20)
  commenter_name       String    @db.VarChar(50)
  comment_text         String    @db.VarChar(500)
  published_date       String    @db.VarChar(500)
  is_reply             Boolean   @default(false)
  top_level_comment_id String?   @db.VarChar(50)
  processed_at         DateTime?

  video Video @relation(fields: [video_id], references: [video_id])
}

model Claim {
  claim_id     String    @id @db.VarChar(20)
  video_id     String    @db.VarChar(20)
  narrative_id String?   @db.Uuid
  video_title  String    @db.VarChar(500)
  claim_text   String    @db.Text
  processed_at DateTime?

  video     Video      @relation(fields: [video_id], references: [video_id])
  narrative Narrative? @relation(fields: [narrative_id], references: [narrative_id])
}

model Narrative {
  narrative_id       String                    @id @default(uuid()) @db.Uuid
  board_id           Int
  title              String                    @db.VarChar(500)
  summary            String?                   @db.Text
  topic_label        String?                   @db.VarChar(200)
  claim_count        Int                       @default(0)
  // centroid_embedding Unsupported("vector(1536)")?
  first_seen_at      DateTime?
  last_seen_at       DateTime?

  board  Board   @relation(fields: [board_id], references: [board_id])
  claims Claim[]
}

model BoardChannel {
  board_id     Int
  channel_id   String    @db.VarChar(50)
  processed_at DateTime?

  board   Board   @relation(fields: [board_id], references: [board_id])
  channel Channel @relation(fields: [channel_id], references: [channel_id])

  @@id([board_id, channel_id])
}

model Keyword {
  keyword_id   Int       @id @default(autoincrement())
  board_id     Int
  keyword      String    @db.VarChar(50)
  processed_at DateTime?

  board Board @relation(fields: [board_id], references: [board_id])
}