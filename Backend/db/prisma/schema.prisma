// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Plan {
  free
  analyst
  enterprise
}

enum Role {
  user
  admin
}

model User {
  user_id     String   @id @default(uuid()) @db.Uuid
  name        String  
  email       String   @unique
  initials    String
  plan        Plan     @default(free)
  role        Role     @default(user)
  password    String
  created_at  DateTime @default(now())

  boards Board[]
}


enum Layout {
  overview
  trends
  claims
}

model Board {
  board_id        String    @id @default(uuid()) @db.Uuid
  user_id         String    @db.Uuid
  board_name      String    @db.VarChar(500)
  description     String?   @db.VarChar(500)
  search_terms    String[]
  layout          Layout    @default(overview)
  last_updated_at DateTime  @updatedAt
  created_at      DateTime  @default(now())

  user          User           @relation(fields: [user_id], references: [user_id], onDelete: Cascade)
  videos        Video[]
  narratives    Narrative[]
  boardChannels BoardChannel[]
  trends        Trend[]
}


enum RiskLevel {
  low
  medium
  high
}


model Channel {
  channel_id    String    @id @db.VarChar(50)
  channel_name  String    @db.VarChar(500)
  total_claims  Int
  flagged_claims  Int
  accuracy_rate  Float
  risk_level     RiskLevel
  risk_score     Float
  last_assessed_at DateTime  @updatedAt
  processed_at  DateTime?

  videos        Video[]
  transcripts   Transcript[]
  boardChannels BoardChannel[]
}

model Video {
  video_id         String    @id @db.VarChar(20)
  board_id         String    @db.Uuid
  channel_id       String    @db.VarChar(50)
  title            String    @db.VarChar(500)
  description      String?   @db.Text
  view_count       Int
  duration_seconds Int?
  published_at     DateTime
  processed        Boolean   @default(false)
  processed_at     DateTime?

  board      Board        @relation(fields: [board_id], references: [board_id], onDelete: Cascade)
  channel    Channel      @relation(fields: [channel_id], references: [channel_id], onDelete: Cascade)
  transcript Transcript?
  comments   Comment[]
  claims     Claim[]
}

model Transcript {
  transcript_id Int       @id @default(autoincrement())
  video_id      String    @unique @db.VarChar(20)
  channel_id    String?   @db.VarChar(50)
  video_title   String    @db.VarChar(500)
  transcript    String    @db.Text
  processed_at  DateTime?

  video   Video               @relation(fields: [video_id], references: [video_id], onDelete: Cascade)
  channel Channel?            @relation(fields: [channel_id], references: [channel_id])
  chunks  TranscriptChunk[]
}

model TranscriptChunk {
  chunk_id      Int       @id @default(autoincrement())
  transcript_id Int
  video_title   String    @db.VarChar(500)
  chunk_text    String    @db.Text
  chunk_number  Int
  processed_at  DateTime?

  transcript Transcript @relation(fields: [transcript_id], references: [transcript_id], onDelete: Cascade)
}

model Comment {
  comment_id           String    @id @db.VarChar(50)
  video_id             String    @db.VarChar(20)
  commenter_name       String    @db.VarChar(50)
  comment_text         String    @db.VarChar(500)
  published_date       String    @db.VarChar(500)
  is_reply             Boolean   @default(false)
  top_level_comment_id String?   @db.VarChar(50)
  processed_at         DateTime?

  video Video @relation(fields: [video_id], references: [video_id], onDelete: Cascade)
}

enum ClaimType {
  factual
  opinion
}


model Claim {
  claim_id          String    @id @default(uuid()) @db.Uuid
  video_id          String    
  narrative_id      String?   
  video_title       String    @db.VarChar(500)
  claim_text        String    @db.Text
  claim_type        ClaimType
  confidence_score  Float
  risk_level        RiskLevel
  processed_at      DateTime  @default(now())
  is_verified       Boolean
  accuracy_rating   Float?

  video     Video      @relation(fields: [video_id], references: [video_id], onDelete: Cascade)
  narrative Narrative? @relation(fields: [narrative_id], references: [narrative_id], onDelete: Cascade)
}

model Narrative {
  narrative_id       String                    @id 
  board_id           String                    @db.Uuid
  title              String                    @db.VarChar(500)
  summary            String?                   @db.Text
  topic_label        String?                   @db.VarChar(200)
  claim_count        Int                       @default(0)
  color              String
  first_seen_at      DateTime                  @default(now())
  last_seen_at       DateTime                  @updatedAt

  board  Board   @relation(fields: [board_id], references: [board_id], onDelete: Cascade)
  claims Claim[]
  trendDatasets TrendData[]
}




enum Direction {
  rising
  peaking
  declining
  stable
}


model Trend {
  trend_id     String         @id @default(uuid()) @db.Uuid
  board_id     String         @db.Uuid
  labels       String[]
  created_at   DateTime       @default(now())

  board    Board          @relation(fields: [board_id], references: [board_id], onDelete: Cascade)
  datasets TrendData[]
}

model TrendData {
  dataset_id   String         @id @default(uuid()) @db.Uuid
  trend_id     String         @db.Uuid
  narrative_id String         
  label        String         @db.VarChar(50)
  color        String         @db.VarChar(50)
  data         Int[]
  direction    Direction
  

  trend     Trend     @relation(fields: [trend_id], references: [trend_id], onDelete: Cascade)
  narrative Narrative @relation(fields: [narrative_id], references: [narrative_id], onDelete: Cascade)
  @@unique([trend_id, narrative_id])
}











model BoardChannel {
  board_id     String    @db.Uuid
  channel_id   String    @db.VarChar(50)
  processed_at DateTime?

  board   Board   @relation(fields: [board_id], references: [board_id], onDelete: Cascade)
  channel Channel @relation(fields: [channel_id], references: [channel_id])

  @@id([board_id, channel_id])
}
